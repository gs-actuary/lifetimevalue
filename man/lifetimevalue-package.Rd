\name{lifetimevalue-package}
\alias{lifetimevalue}
\alias{lifetimevalue-package}
\docType{package}
\title{lifetimevalue: Insurance Lifetime Value and Asset Share Pricing}
\description{
A small set of deterministic tools for projecting multi-period insurance profitability. The package is designed for asset-share-style analysis in which premium, losses, expenses, retention, and discounting vary over the life of a policy relationship.
}
\details{
The package has no runtime dependencies outside base R. Its primary functions are \code{build_ltv_path()}, \code{summarize_ltv()}, \code{solve_ltv_premium()}, and \code{equal_profit_discount()}.
}
\keyword{internal}
